rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'k7286113@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && request.auth.token.email_verified == true)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    // Role escalation prevention: non-admins can never assign role: 'admin' or alter their role/status
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && 
        incoming().role == 'student';
      allow update: if (isOwner(userId) && 
        (!('role' in incoming()) || incoming().role == existing().role) &&
        (!('status' in incoming()) || incoming().status == existing().status)
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Student academic & preference profiles - read/update gated to verified users or admin
    match /studentProfiles/{userId} {
      allow get: if isVerified() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isVerified() && isOwner(userId) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // Career survey assessment submissions - gated to verified users or admin
    match /surveyResults/{resultId} {
      allow get: if isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerified() && existing().userId == request.auth.uid);
      allow create: if isVerified() && incoming().userId == request.auth.uid && isValidId(resultId);
      allow update, delete: if isAdmin();
    }

    // Student interaction & platform activity audit logs
    match /studentActivity/{activityId} {
      allow get: if isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerified() && existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(activityId);
      allow update, delete: if isAdmin();
    }

    // Student privacy data erasure / deletion requests
    match /deletionRequests/{requestId} {
      allow get: if isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && incoming().userId == request.auth.uid && isValidId(requestId);
      allow update, delete: if isAdmin();
    }

    // Admin role verification collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Analytics telemetry and custom event records
    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isValidId(eventId);
      allow update, delete: if isAdmin();
    }
  }
}

