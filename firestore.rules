rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin role verification:
    // Requires genuine authentication, email verification, AND one of:
    // 1. Authorized primary admin email (bootstrap)
    // 2. Verified admin custom claim on Firebase token
    // 3. Document in trusted /admins/{uid} collection
    function isAdmin() {
      return isSignedIn() && isVerified() && (
        request.auth.token.email == 'k7286113@gmail.com' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    // Role escalation prevention: students can NEVER assign role: 'admin' or alter roles
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && 
        incoming().role == 'student' &&
        incoming().uid == userId;
      allow update: if (isOwner(userId) && isValidId(userId) &&
        // Prevent role tampering
        (!('role' in incoming()) || incoming().role == existing().role) &&
        // Allow status updates: student can move to active only if verified, or request deletion
        (!('status' in incoming()) || incoming().status == existing().status || 
          (incoming().status == 'active' && isVerified()) ||
          incoming().status == 'deletion_requested'
        )
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Student academic & preference profiles
    // Private to the authenticated student owner or verified admin
    match /studentProfiles/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // Career survey assessment submissions
    match /surveyResults/{resultId} {
      allow get: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(resultId);
      allow update, delete: if isAdmin();
    }

    // Student interaction & platform activity audit logs
    // Allows logging by authenticated students as well as guest learners exploring careers
    match /studentActivity/{activityId} {
      allow get: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(activityId) && (
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (!isSignedIn() && incoming().userId == 'guest_user')
      );
      allow update, delete: if isAdmin();
    }

    // Student privacy data erasure / deletion requests
    match /deletionRequests/{requestId} {
      allow get: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(requestId);
      allow update, delete: if isAdmin();
    }

    // Admin role verification collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Analytics telemetry and custom event records
    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isValidId(eventId);
      allow update, delete: if isAdmin();
    }

    // Health check & connection diagnostic endpoint
    match /test/{testId} {
      allow get: if true;
    }
  }
}
