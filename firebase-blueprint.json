{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered student account record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "fullName": { "type": "string", "maxLength": 100 },
        "emailVerified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "status": { "type": "string", "enum": ["active", "pending_verification", "deletion_requested", "suspended"] },
        "lastSignInAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "createdAt"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student academic preferences, saved careers, colleges and readiness",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 256 },
        "grade": { "type": "string", "maxLength": 50 },
        "stream": { "type": "string", "maxLength": 50 },
        "targetExam": { "type": "string", "maxLength": 100 },
        "marksSubmitted": { "type": "string", "maxLength": 200 },
        "careerInterests": { "type": "array" },
        "savedCareers": { "type": "array" },
        "savedColleges": { "type": "array" },
        "savedRoadmaps": { "type": "array" },
        "guidanceChecklist": { "type": "array" },
        "pdfGeneratedCount": { "type": "number" },
        "lastReportDate": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "updatedAt"]
    },
    "SurveyResult": {
      "title": "SurveyResult",
      "description": "Student 5-step career survey assessment result and match recommendations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentEmail": { "type": "string", "maxLength": 256 },
        "grade": { "type": "string", "maxLength": 50 },
        "stream": { "type": "string", "maxLength": 50 },
        "marksDetails": { "type": "string", "maxLength": 200 },
        "interests": { "type": "array" },
        "workStyle": { "type": "string", "maxLength": 100 },
        "topCareers": { "type": "array" },
        "answers": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "studentName", "stream", "topCareers", "createdAt"]
    },
    "StudentActivity": {
      "title": "StudentActivity",
      "description": "Log of student events such as career exploration, survey completion, and PDF generation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "actionType": { "type": "string", "maxLength": 100 },
        "resourceTitle": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "actionType", "timestamp"]
    },
    "DeletionRequest": {
      "title": "DeletionRequest",
      "description": "Student data deletion request under privacy regulations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "reason": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "processed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator accounts with RBAC access to admin dashboard",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin"] },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Custom GA4 and website platform analytics telemetry event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "eventName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "label": { "type": "string", "maxLength": 250 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "eventName", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and authentication document"
    },
    "/studentProfiles/{userId}": {
      "schema": "StudentProfile",
      "description": "Student private preferences and bookmarks"
    },
    "/surveyResults/{resultId}": {
      "schema": "SurveyResult",
      "description": "Career assessment survey results"
    },
    "/studentActivity/{activityId}": {
      "schema": "StudentActivity",
      "description": "Platform audit and activity log"
    },
    "/deletionRequests/{requestId}": {
      "schema": "DeletionRequest",
      "description": "User data privacy and erasure requests"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Privileged admin identifiers for dashboard security"
    },
    "/analyticsEvents/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Platform telemetry and visitor engagement statistics"
    }
  }
}
